<?xml version="1.0" encoding="UTF-8"?>
<!--
  BRAND_SPEC §2 — the static launch screen.

  Brand blue full-bleed, and the bowl ALONE at 112pt. No dome and no wordmark:
  at frame 0 of the splash both are invisible (trim 0, opacity 0), and the whole
  point of this file is to be frame 0 exactly.

  A storyboard rather than the simpler `UILaunchScreen` plist dict, because that
  one only centres its image and scales it to the screen — it cannot say 112pt,
  and it cannot say 46% of the height. `centerY` with multiplier 0.92 is that
  46%: half of 92%.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="LSC-vc-001">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="LSC-sc-001">
            <objects>
                <viewController id="LSC-vc-001" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LSC-vw-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchBowl" translatesAutoresizingMaskIntoConstraints="NO" id="LSC-iv-001">
                                <rect key="frame" x="140.5" y="363" width="112" height="56"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="112" id="LSC-cn-003"/>
                                    <constraint firstAttribute="height" constant="56" id="LSC-cn-004"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="LSC-sa-001"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="LSC-iv-001" firstAttribute="centerX" secondItem="LSC-vw-001" secondAttribute="centerX" id="LSC-cn-001"/>
                            <constraint firstItem="LSC-iv-001" firstAttribute="centerY" secondItem="LSC-vw-001" secondAttribute="centerY" multiplier="0.92" id="LSC-cn-002"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="LSC-fr-001" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBowl" width="112" height="56"/>
        <namedColor name="LaunchBackground">
            <color red="0.0" green="0.38431372549019608" blue="0.69019607843137254" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
