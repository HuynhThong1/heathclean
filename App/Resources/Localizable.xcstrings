    "AI PHÂN TÍCH · bạn xác nhận": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ANALYSIS · you confirm"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI PHÂN TÍCH · bạn xác nhận"
          }
        }
      }
    },
    "AI nhận diện món và ước lượng khẩu phần. Calo do cơ sở dữ liệu dinh dưỡng tính — hãy sửa khẩu phần nếu chưa đúng.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI names the dish and estimates the portion. Calories come from a nutrition database — correct the portion if it looks wrong."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI nhận diện món và ước lượng khẩu phần. Calo do cơ sở dữ liệu dinh dưỡng tính — hãy sửa khẩu phần nếu chưa đúng."
          }
        }
      }
    },
    "AI nhận diện món ăn, cơ sở dữ liệu dinh dưỡng tính calo, và bạn là người xác nhận cuối cùng.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI recognises the dish, a nutrition database counts the calories, and you have the final say."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI nhận diện món ăn, cơ sở dữ liệu dinh dưỡng tính calo, và bạn là người xác nhận cuối cùng."
          }
        }
      }
    },
    "AI nhận diện món ăn, cơ sở dữ liệu tính calo, và bạn xác nhận trước khi lưu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI recognises the dish, a database counts the calories, and you confirm before anything is saved."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI nhận diện món ăn, cơ sở dữ liệu tính calo, và bạn xác nhận trước khi lưu."
          }
        }
      }
    },
