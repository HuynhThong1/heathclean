<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Injected at build time for device builds. The environment variable with
	     the same name still takes precedence when launched through Xcode. -->
	<key>GATEWAY_URL</key>
	<string>$(GATEWAY_URL)</string>
	<!-- Shared secret for a deployed gateway, sent as X-API-Key. Empty for a
	     local run: an unconfigured GATEWAY_API_KEY leaves the gateway open. -->
	<key>GATEWAY_API_KEY</key>
	<string>$(GATEWAY_API_KEY)</string>
	<!--
	  Both of the next two keys exist so the app can talk to the gateway running
	  on a Mac on the same Wi-Fi (GATEWAY_URL=http://192.168.1.x:8000).

	  App Transport Security blocks plaintext HTTP, and iOS 14+ additionally
	  requires local-network permission before an app may open a connection to a
	  private address — without either, the request fails and the scan falls back
	  to looking like a network error.

	  NSAllowsLocalNetworking is the narrow exception: it permits HTTP to local
	  and private addresses only, and leaves ATS enforced everywhere else.

	  It does NOT cover the deployed gateway. A VPS has a public address, so
	  reaching it over plaintext HTTP needs its own NSExceptionDomains entry —
	  see the placeholder below. That entry is temporary scaffolding for testing
	  against an IP: once the gateway has a domain and a certificate, delete it
	  and let ATS do its job. Do not reach for NSAllowsArbitraryLoads instead;
	  it disables ATS for every host the app will ever contact, to fix one.
	-->
	<!--
	  There is deliberately no `UIUserInterfaceStyle` key here.

	  It was set to Light for a while, because `DS.*` had no dark values and only
	  `DSButtonStyle` (which reads the adaptive `DSColor` set) responded to dark
	  mode — so the buttons moved and the screens did not. `DS.*` now has a dark
	  palette and `AppAppearance` owns the choice, applied as
	  `preferredColorScheme` at the app root. This key would override that and
	  silently make the "Tối" setting do nothing.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- The deployed gateway, matched as an exact IP literal — this is no
		     longer the documentation placeholder, so plaintext HTTP to this one
		     host is now permitted and the scan can reach it. Remove this whole
		     dict once the gateway is HTTPS; NSExceptionAllowsInsecureHTTPLoads is
		     the cost of testing against a bare IP, not a setting worth keeping,
		     and the API key crosses the wire in clear text until it goes.
		     Changing the VPS address means changing it here too: nothing derives
		     this from GATEWAY_URL, so the two can disagree silently and the only
		     symptom is a scan that fails as a network error. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>64.176.83.254</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>HeathFirst connects to the meal-recognition gateway running on your computer over the local network. This is used for development builds only.</string>
	<key>NSCameraUsageDescription</key>
	<string>HeathFirst uses the camera to photograph your meal so the food in it can be recognised. The photo is analysed and then discarded — it is never stored.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>HeathFirst reads your weight, steps, energy burned and sleep from Apple Health so your dashboard reflects your actual activity. This data stays on your device.</string>
	<key>UIAppFonts</key>
	<array>
		<string>BeVietnamPro-Light.ttf</string>
		<string>BeVietnamPro-Regular.ttf</string>
		<string>BeVietnamPro-Medium.ttf</string>
		<string>BeVietnamPro-SemiBold.ttf</string>
		<string>BeVietnamPro-Bold.ttf</string>
		<string>BeVietnamPro-ExtraBold.ttf</string>
	</array>
</dict>
</plist>
